# Local-only example. Copy to .env and replace the example values.
ENVIRONMENT=local
DATABASE_ENVIRONMENT=local
DATABASE_URL=
LEGACY_DATABASE_URL=
SATT_DB_HOST=
SATT_DB_PORT=
SATT_DB_NAME=
SATT_DB_USER=
SATT_DB_PASSWORD=
SATT_APP_PORT=
SECRET_KEY=replace-with-a-local-random-secret
SITE_URL=http://localhost:8200
CORS_ORIGINS=http://localhost:8200,http://127.0.0.1:8200
COMMIT_SHA=local
AI_REQUEST_TIMEOUT=60

# Keep external integrations disabled locally by default.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
ALLOW_NONPRODUCTION_EXTERNAL_SERVICES=false
